#!/bin/sh
# Opens a folder on a remote host as an editor tab in the running Wheelhouse IDE.
# The host is anything `ssh <host>` reaches without asking for a password.
#   wheelhouse/remote-folder myhost '~/src/project'
#   wheelhouse/remote-folder myhost /srv/app --workspace workspace:3
# The app checks the folder on the host; one it does not find is reported in the app.
set -eu
. "$(dirname "$0")/lib.sh"
[ $# -ge 2 ] || { echo "usage: wheelhouse/remote-folder <host> <folder> [--workspace <id>]" >&2; exit 2; }
host=$1
folder=$2
shift 2
workspace=
[ "${1:-}" = "--workspace" ] && workspace=${2:?--workspace needs an id}
case "$host" in
  */*|.|..|""|-*) echo "not a host: $host" >&2; exit 2 ;;
esac

json() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
params="\"host\":\"$(json "$host")\",\"path\":\"$(json "$folder")\""
[ -z "$workspace" ] || params="$params,\"workspace_id\":\"$(json "$workspace")\""
exec "$(dirname "$0")/cli" rpc wheelhouse.remote_folder.open "{$params}"
